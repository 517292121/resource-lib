<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd" >
<hibernate-mapping>
	<!--
		Created by the Middlegen Hibernate plugin 2.2
		http://boss.bekk.no/boss/middlegen/ http://www.hibernate.org/
	-->
	<class name="cn.com.adtech.riss2.domain.SysCatalog" table="SYS_CATALOG"
		lazy="false" dynamic-update="true">
		<cache usage="read-write" />
		<id name="scatId" type="java.lang.Long" column="SCAT_ID">
			<generator class="com.jbetter.hibernate.IdGenerator" />
		</id>
		<property name="scatName" type="java.lang.String" column="SCAT_NAME"
			not-null="true" length="128" />
		<property name="scatDesc" type="java.lang.String" column="SCAT_DESC"
			length="512" />
		<property name="scatCode" type="java.lang.Short" column="SCAT_CODE" />
		<!-- Associations -->
		<!-- uni-directional many-to-one association to SysCatalog -->
		<many-to-one name="parentCatalog" class="cn.com.adtech.riss2.domain.SysCatalog">
			<column name="SCAT_PARENT_ID" />
		</many-to-one>
	</class>
</hibernate-mapping>