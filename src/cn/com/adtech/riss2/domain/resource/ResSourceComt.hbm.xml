<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd" >
<hibernate-mapping>
	<class name="cn.com.adtech.riss2.domain.resource.ResSourceComt" table="RES_SOURCE_COMT"
		lazy="false" dynamic-update="true">
		<cache usage="read-write" />
		<id name="rscoId" type="java.lang.Long" column="RSCO_ID">
			<generator class="com.jbetter.hibernate.IdGenerator" />
		</id>
		<property name="rscoRsdaId" type="java.lang.Long" column="RSCO_RSDA_ID" not-null="true"/>
		<property name="rscoSuinId" type="java.lang.Long" column="RSCO_SUIN_ID" />
		<property name="rscoRefid" type="java.lang.Long" column="RSCO_REFID"/>
		
		<property name="rscoContent" type="java.lang.String" column="RSCO_CONTENT" length="300"/>
		<property name="rscoGrade" type="java.lang.Short" column="RSCO_GRADE" />
		<property name="rscoStatus" type="java.lang.Short" column="RSCO_STATUS" />
		
		<property name="rscoDate" type="java.util.Date" column="RSCO_DATE" />
		
		<many-to-one name="sysUserinfo" class="cn.com.adtech.riss2.domain.SysUserinfo" insert="false" update="false">
			<column name="RSCO_SUIN_ID"/>
		</many-to-one>
		<many-to-one name="resSourceData" class="cn.com.adtech.riss2.domain.resource.ResSourceData" insert="false" update="false">
			<column name="RSCO_RSDA_ID"/>
		</many-to-one>
		<many-to-one name="parentSourceComt" class="cn.com.adtech.riss2.domain.resource.ResSourceComt" insert="false" update="false">
			<column name="RSCO_REFID"/>
		</many-to-one>
	</class>
</hibernate-mapping>