<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
	<class name="cn.com.adtech.riss2.domain.infosubscription.InfoSubscription"
		table="IS_INFO_SUBSCRIPTION" lazy="false" dynamic-update="true">
		<id name="issId" type="java.lang.Long">
			<column name="IS_ID" />
			<generator class="com.jbetter.hibernate.IdGenerator" />
		</id>
		<property name="issKeyWord" type="java.lang.String">
			<column name="IS_KEYWORD" />
		</property>
		<property name="issDate" type="java.util.Date">
			<column name="IS_DATE" />
		</property>
		<property name="issUserId" type="java.lang.Long">
			<column name="IS_USER_ID" />
		</property>
		<many-to-one name="issUser"
			class="cn.com.adtech.riss2.domain.SysUserinfo" fetch="select"
			insert="false" update="false">
			<column name="IS_USER_ID" />
		</many-to-one>
	</class>
</hibernate-mapping>
