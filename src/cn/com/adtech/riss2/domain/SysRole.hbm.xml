<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
    "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd" >
    
<hibernate-mapping>
<!-- 
    Created by the Middlegen Hibernate plugin 2.2

    http://boss.bekk.no/boss/middlegen/
    http://www.hibernate.org/
-->

<class 
    name="cn.com.adtech.riss2.domain.SysRole" 
    table="SYS_ROLE"
    lazy="false" dynamic-update= "true"
>
	<cache usage="read-write" />
    <id
        name="srolId"
        type="java.lang.Long"
        column="SROL_ID"
    >
    
        <generator class="com.jbetter.hibernate.IdGenerator" />
    </id>

    <property
        name="srolName"
        type="java.lang.String"
        column="SROL_NAME"
        not-null="true"
        length="128"
    />
    <property
        name="srolCode"
        type="java.lang.String"
        column="SROL_CODE"
        not-null="true"
        length="64"
    />
    <property
        name="srolDesc"
        type="java.lang.String"
        column="SROL_DESC"
        length="512"
    />
    <property
        name="srolIsSysRole"
        type="java.lang.Boolean"
        column="SROL_IS_SYS_ROLE"
    />

    <set 
        name="sysRoleFunctions"
        lazy= "false" cascade="delete"
    	inverse="true"
    >
        <key>
            <column name="SRFU_SROL_ID" />
        </key>
        
        <one-to-many 
            class="cn.com.adtech.riss2.domain.SysRoleFunction"
        />
    </set>
    


</class>
</hibernate-mapping>
