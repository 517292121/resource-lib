<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
	<class name="cn.com.adtech.riss2.domain.rss.RssUserData" table="RSS_USER_DATA"
		lazy="false" dynamic-update="true">
		<id name="rssDataId" type="java.lang.Long">
			<column name="RSS_DATA_ID" />
			<generator class="com.jbetter.hibernate.IdGenerator" />
		</id>
		<property name="rssDataName" type="java.lang.String">
			<column name="RSS_DATA_NAME" not-null="true" />
		</property>
		<property name="rssDataSourceUrl" type="java.lang.String">
			<column name="RSS_DATA_SOURCE_URL" not-null="true" />
		</property>
		<property name="rssDataAddDate" type="java.util.Date">
			<column name="RSS_DATA_ADD_DATE" not-null="true" />
		</property>
		<property name="rssDataLastModifyDate" type="java.util.Date">
			<column name="RSS_DATA_LAST_MODIFY_DATE" />
		</property>
		<property name="rssDataUserId" type="java.lang.Long">
			<column name="RSS_DATA_USER_ID" not-null="true" />
		</property>
		<property name="rssDataOrder" type="java.lang.Integer">
			<column name="RSS_DATA_ORDER" not-null="true" />
		</property>
		<many-to-one name="rssDataUser" class="cn.com.adtech.riss2.domain.SysUserinfo"
			fetch="select" insert="false" update="false">
			<column name="RSS_DATA_USER_ID" not-null="true" />
		</many-to-one>
		<property name="rssDataDisplayNum" type="java.lang.Integer">
			<column name="RSS_DATA_DISPLAY_NUM"  />
		</property>
	</class>
</hibernate-mapping>