<?xml version="1.0" encoding="UTF-8"?>
<web-app version="2.5" xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee 
	http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd">
	<display-name>Riss2</display-name>
	<description></description>
	<context-param>
		<param-name>contextConfigLocation</param-name>
		<param-value>
			/WEB-INF/config/applicationContext.xml,/WEB-INF/config/bsoBean.xml
		</param-value>
	</context-param>
	<!-- 配置ajax的json_rpc组件 -->
	<servlet>
		<servlet-name>JsonRpc</servlet-name>
		<servlet-class>com.metaparadigm.jsonrpc.JSONRPCServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>JsonRpc</servlet-name>
		<url-pattern>/Json_Rpc</url-pattern>
	</servlet-mapping>
	<!-- 图片上传servlet -->
	<servlet>
		<servlet-name>FileUpload</servlet-name>
		<servlet-class>cn.com.adtech.riss2.servlet.FileUpload</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>FileUpload</servlet-name>
		<url-pattern>/FileUpload</url-pattern>
	</servlet-mapping>
	<!-- 下载路径配置,即文件访问路径。因此一定要设置成服务器的访问地址  -->
	<context-param>
		<param-name>downLoadPath</param-name>
		<param-value>http://localhost:8080/fileService</param-value>
	</context-param>
	<context-param>
		<param-name>fileDe</param-name>
		<param-value>views/common/adlib.key</param-value>
	</context-param>
	<filter>
		<filter-name>CharacterEncodingFilter</filter-name>
		<filter-class>org.springframework.web.filter.CharacterEncodingFilter</filter-class>
		<init-param>
			<param-name>encoding</param-name>
			<param-value>UTF-8</param-value>
		</init-param>
		<init-param>
			<param-name>forceEncoding</param-name>
			<param-value>true</param-value>
		</init-param>
	</filter>
	<filter-mapping>
		<filter-name>CharacterEncodingFilter</filter-name>
		<url-pattern>/*</url-pattern>
	</filter-mapping>
	<listener>
		<listener-class>org.springframework.web.context.ContextLoaderListener</listener-class>
	</listener>
	<servlet>
		<servlet-name>riss2</servlet-name>
		<servlet-class>org.springframework.web.servlet.DispatcherServlet</servlet-class>
		<load-on-startup>1</load-on-startup>
	</servlet>
	<servlet-mapping>
		<servlet-name>riss2</servlet-name>
		<url-pattern>*.htm</url-pattern>
	</servlet-mapping>
	<servlet-mapping>
		<servlet-name>riss2</servlet-name>
		<url-pattern>/</url-pattern>
	</servlet-mapping>
	
	
	
	<!-- 
	<filter>
		<filter-name>isUse</filter-name>
		<filter-class>cn.com.adtech.riss2.filter.UseDateFilter</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>isUse</filter-name>
		<url-pattern>/*</url-pattern>
	</filter-mapping> -->
	<!-- Filter -->
	<filter>
		<filter-name>accessFilter</filter-name>
		<filter-class>cn.com.adtech.riss2.filter.AccessFilter</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>accessFilter</filter-name>
		<url-pattern>/console/data/*</url-pattern>
	</filter-mapping>
	
	<filter>
	  <filter-name>xssfilter</filter-name>
	  <filter-class>cn.com.adtech.riss2.filter.MyXssFilter</filter-class>
	</filter>
	<filter-mapping>
	  <filter-name>xssfilter</filter-name>
	  <url-pattern>/*</url-pattern>
	</filter-mapping>
	
	<!-- listener 站点访问量统计 -->
	<listener>
		<listener-class>cn.com.adtech.riss2.listener.AccessCounterListener</listener-class>
	</listener>
	<!-- dwr -->
	<servlet>
		<servlet-name>dwr-invoker</servlet-name>
		<servlet-class>uk.ltd.getahead.dwr.DWRServlet</servlet-class>
		<init-param>
			<param-name>config</param-name>
			<param-value>WEB-INF/config/dwr.xml</param-value>
		</init-param>
		<init-param>
			<param-name>debug</param-name>
			<param-value>true</param-value>
		</init-param>
		<init-param>
			<param-name>crossDomainSessionSecurity</param-name>
			<param-value>false</param-value>
		</init-param>
	</servlet>
	<servlet-mapping>
		<servlet-name>dwr-invoker</servlet-name>
		<url-pattern>/dwr/*</url-pattern>
	</servlet-mapping>
	
	<!-- 更新全文检索索引 -->
    <servlet>
        <servlet-name>createLuceneIndex</servlet-name>
        <servlet-class>cn.com.adtech.riss2.servlet.CreateLuceneIndex</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>createLuceneIndex</servlet-name>
        <url-pattern>/servlet/createLuceneIndex</url-pattern>
    </servlet-mapping>
    
	<!-- 容器启动初始化首页缓存数据,和论文系统相关全局参数初始化。如果不要此随容器启动而初始化首页缓存数据,请把<load-on-startup>注释掉 -->
	<servlet>
		<servlet-name>IndexDataCachServlet</servlet-name>
		<servlet-class>cn.com.adtech.riss2.servlet.UpdateAllCache</servlet-class>
		<load-on-startup>1</load-on-startup>
	</servlet>
	
	
	<!-- 一键更新系统前台索引和首页缓存 -->
	<servlet>
		<servlet-name>UpdateAllCache</servlet-name>
		<servlet-class>cn.com.adtech.riss2.servlet.UpdateAllCache</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>UpdateAllCache</servlet-name>
		<url-pattern>/servlet/updateAllCache</url-pattern>
	</servlet-mapping>
	
	<!-- 更新自定义分类资源数量统计 -->
	<servlet>
		<servlet-name>UpdateGroupCount</servlet-name>
		<servlet-class>cn.com.adtech.riss2.servlet.UpdateGroupCount</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>UpdateGroupCount</servlet-name>
		<url-pattern>/servlet/updateGroupCount</url-pattern>
	</servlet-mapping>
	
	<session-config> 
		<session-timeout>200</session-timeout> 
	</session-config>
    <welcome-file-list>
		<welcome-file>index.jsp</welcome-file>
	</welcome-file-list>
    
	
</web-app>