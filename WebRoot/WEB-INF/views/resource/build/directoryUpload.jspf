<%@ page pageEncoding="UTF-8" %>
<div class="directory-upload">
    <table cellpadding="0" width="100%" border="0" cellspacing="1">
        <tr height="25">
            <td width="150" align="right"><img src="${pageContext.request.contextPath}/images/extform/bullet_add_2.png" alt="" /> <label for="directoryCover">封 面：</label></td>
            <td><input id="directoryCover" name="directoryCover" type="file" class="file text" accept=".jpg,.jpeg,.png,.gif,.bmp" />&nbsp;<span class="tips">封面文件格式:jpg、jpeg、bmp、png、gif（可选）</span></td>
        </tr>
        <tr height="25">
            <td width="150" align="right"><img src="${pageContext.request.contextPath}/images/extform/bullet_add_2.png" alt="" /> <label for="directoryMode">资源来源：</label></td>
            <td><select name="directoryMode" id="directoryMode" class="file text">
                <option value="server">使用服务器已有目录</option>
                <option value="zip">上传 ZIP 压缩包并解压</option>
                <option value="folder">选择本地文件夹上传</option>
            </select></td>
        </tr>
        <tr height="25" data-directory-mode="server">
            <td width="150" align="right"><img src="${pageContext.request.contextPath}/images/extform/bullet_add_2.png" alt="" /> <label for="resourceDirectory">服务器目录：</label></td>
            <td><input id="resourceDirectory" name="imgDir" type="text" class="file text" maxlength="512" value="<c:if test='${resource.rsdaSourceType == 1}'><c:out value='${resource.rsdaFileUrl}'/></c:if>" onchange="urlpath(this);" /></td>
        </tr>
        <tr class="directory-note" data-directory-mode="server"><td></td><td class="tips">如：D:/ResourceFile/RISS2-MLAN/resource/呐喊（服务器上的实际目录）</td></tr>
        <tr height="25" data-directory-mode="zip" style="display:none">
            <td width="150" align="right"><img src="${pageContext.request.contextPath}/images/extform/bullet_add_2.png" alt="" /> <label for="resourceArchive">压 缩 包：</label></td>
            <td><input id="resourceArchive" name="resourceArchive" type="file" class="file text" accept=".zip" disabled />&nbsp;<span class="tips">压缩包格式:ZIP</span></td>
        </tr>
        <tr class="directory-note" data-directory-mode="zip" style="display:none"><td></td><td class="tips">保存时自动解压到系统资源目录，保留中文文件名和目录结构。</td></tr>
        <tr height="25" data-directory-mode="folder" style="display:none">
            <td width="150" align="right"><img src="${pageContext.request.contextPath}/images/extform/bullet_add_2.png" alt="" /> <label for="directoryFiles">文 件 夹：</label></td>
            <td><input id="directoryFiles" name="directoryFiles" type="file" class="file text" webkitdirectory directory multiple disabled /><input type="hidden" id="directoryPaths" name="directoryPaths" value="[]" /></td>
        </tr>
        <tr class="directory-note" data-directory-mode="folder" style="display:none"><td></td><td class="tips" id="directorySelection">选择资源文件夹后，将保留目录结构上传到服务器。</td></tr>
        <tr class="directory-note"><td></td><td class="tips">不选择封面则保留原封面，无封面时使用文献库默认封面。<br />支持 TXT 章节、页面图片、PDF、Excel 目录和 XML 切片配置；TXT 按文件名中的数字排序。</td></tr>
        <tr class="directory-note"><td></td><td><p id="directoryUploadError" role="alert"></p></td></tr>
    </table>
</div>
<style>
.directory-upload {padding:0;font-size:12px;}
.directory-upload label {white-space:nowrap;}
.directory-upload .file {background:#fff;vertical-align:middle;}
.directory-upload select.file {box-sizing:content-box;}
.directory-upload .tips {color:#808080;line-height:1.7;white-space:normal;}
.tabbox .content .directory-upload tr.directory-note td {padding:0 0 8px;}
.tabbox .content .directory-upload #directoryUploadError {margin:0;color:#b42318;}
.directory-upload #directoryUploadError:empty {display:none;}
.tabbox .content > ul > li {height:auto;box-sizing:border-box;}
</style>
<script src="${pageContext.request.contextPath}/viewsjs/resource/build/resource-directory-upload.js?v=20261024-1"></script>
